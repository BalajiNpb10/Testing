<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <!-- 1. Define where the logs go (Console and File) -->
    <Appenders>
        <!-- This prints logs to your IDE Console -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} [%t] %-5level - %msg%n"/>
        </Console>

        <!-- This saves logs to a file named 'automation.log' inside a 'logs' folder -->
        <File name="File" fileName="logs/automation.log" append="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %m%n"/>
        </File>
    </Appenders>

    <!-- 2. Enable the loggers -->
    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>

</Configuration>